# Shop portal of the KACHIII backend (docker compose in backend/kachi).
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Live server only: the Cloudflare R2 domain its public images (products, categories,
# home banners) are served from, the backend's R2_MEDIA_URL. Leave empty locally,
# where images come from the API's own /storage.
NEXT_PUBLIC_MEDIA_URL=

# Seller Centre (web/kachiii-seller-front), linked from the header's top bar.
NEXT_PUBLIC_SELLER_URL=http://localhost:3002
